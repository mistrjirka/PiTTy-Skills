{
  "schemaVersion": 1,
  "skills": [
    {
      "name": "designing-agents",
      "path": "skills/designing-agents",
      "description": "Use when designing or editing application agents, prompts, tool surfaces, or non-chat classification, extraction, verification, and creation workflows."
    },
    {
      "name": "gpt-prompting-knowhow",
      "path": "skills/gpt-prompting-knowhow",
      "description": "Use when migrating or evaluating GPT-specific prompt and tool behavior, not for every coding task."
    },
    {
      "name": "designing-structured-output",
      "path": "skills/designing-structured-output",
      "description": "Use when designing model/tool schemas, identity coverage or recovery from invalid structured output."
    },
    {
      "name": "planning-qualitative-optimization",
      "path": "skills/planning-qualitative-optimization",
      "description": "Use when scoping an observed LLM quality failure into a falsifiable real-data experiment."
    },
    {
      "name": "executing-qualitative-optimization",
      "path": "skills/executing-qualitative-optimization",
      "description": "Use when implementing an agreed LLM quality experiment and validating it against representative real sources."
    },
    {
      "name": "running-real-data-smoke-tests",
      "path": "skills/running-real-data-smoke-tests",
      "description": "Use when running a manual real-service smoke test, or when a material integration claim requires evidence from the actual app/runtime or a real external service beyond focused tests."
    },
    {
      "name": "reading-docx",
      "path": "skills/reading-docx",
      "description": "Use when inspecting, searching, comparing, summarizing, or analyzing Microsoft Word .docx files. Convert DOCX to temporary Markdown before content analysis instead of parsing Office XML directly."
    },
    {
      "name": "impl-check",
      "path": "skills/impl-check",
      "description": "Use for a deep implementation review or a completed high-risk cross-layer change requiring independent review."
    },
    {
      "name": "review-final-diff",
      "path": "skills/review-final-diff",
      "description": "Use for a focused direct review of an ordinary completed diff when a full independent impl-check is unnecessary."
    },
    {
      "name": "design-ui",
      "path": "skills/design-ui",
      "description": "Use when designing or changing user-facing layout, interaction, forms or async UI states."
    },
    {
      "name": "triaging-pr-feedback",
      "path": "skills/triaging-pr-feedback",
      "description": "Use when given a GitHub PR link or number to evaluate review feedback against the actual code and, when requested, resolve valid comments."
    },
    {
      "name": "renaming",
      "path": "skills/renaming",
      "description": "Use when a requested rename spans many files or requires coordinated case-preserving text and path changes."
    },
    {
      "name": "writing-skills",
      "path": "skills/writing-skills",
      "description": "Use when creating or auditing SKILL.md, Pi agent profiles or reusable coding-agent instructions."
    },
    {
      "name": "pr-preparation",
      "path": "skills/pr-preparation",
      "description": "Use when checking a named branch or PR for release readiness, configuration, migration and validation gaps."
    },
    {
      "name": "plan",
      "path": "skills/plan",
      "description": "Create or revise a task plan when the user asks for planning. Not needed to execute an already approved plan."
    },
    {
      "name": "diagnosing-agent-prompts",
      "path": "skills/diagnosing-agent-prompts",
      "description": "Use when an agent workflow is slow, repetitive, overengineered, misses delegation/escalation, or otherwise behaves badly and you need to decide whether the cause is prompting, model behavior, runtime/tooling, or task setup before editing prompts."
    },
    {
      "name": "agent-benchmark-preflight",
      "path": "skills/agent-benchmark-preflight",
      "description": "Use immediately before launching an agent/prompt benchmark or A/B run to verify the comparison is controlled, reproducible and safe to leave unattended."
    }
  ],
